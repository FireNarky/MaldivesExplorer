      }
    }
  },
  "typography": {
    "fontFamily": {
      "display": { "value": "Fraunces, 'Iowan Old Style', Palatino, Georgia, serif" },
      "sans": { "value": "'Source Sans 3', 'Segoe UI', system-ui, sans-serif" }
    },
    "scale": {
      "displayLg": { "fontSize": "clamp(2.5rem, 1.2rem + 4vw, 4.5rem)", "lineHeight": "1.08", "letterSpacing": "-0.025em" },
      "h1": { "fontSize": "clamp(2rem, 1rem + 2.2vw, 3.25rem)", "lineHeight": "1.18", "letterSpacing": "-0.015em" },
      "h2": { "fontSize": "clamp(1.625rem, 1rem + 1.2vw, 2.25rem)", "lineHeight": "1.25", "letterSpacing": "-0.01em" },
      "h3": { "fontSize": "clamp(1.25rem, 1rem + 0.4vw, 1.5rem)", "lineHeight": "1.3" },
      "bodyLg": { "fontSize": "1.125rem", "lineHeight": "1.6" },
      "body": { "fontSize": "1rem", "lineHeight": "1.6" },
      "caption": { "fontSize": "0.875rem", "lineHeight": "1.5" },
      "badge": { "fontSize": "0.6875rem", "lineHeight": "1", "letterSpacing": "0.06em", "textTransform": "uppercase" }
    }
  },
  "elevation": {
    "shadow1": { "value": "0 2px 8px rgb(8 59 76 / 6%), 0 1px 2px rgb(8 59 76 / 4%)" },
    "shadow2": { "value": "0 12px 32px rgb(8 59 76 / 10%), 0 4px 8px rgb(8 59 76 / 4%)" },
    "shadow3": { "value": "0 20px 48px rgb(8 59 76 / 14%), 0 6px 12px rgb(8 59 76 / 6%)" }
  },
  "radii": {
    "sm": { "value": "0.375rem" },
    "md": { "value": "0.625rem" },
    "lg": { "value": "1rem" },
    "xl": { "value": "1.5rem" },
    "full": { "value": "999px" }
  }
}
