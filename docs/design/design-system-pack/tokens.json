{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Maldives Explorer Luxury Design System",
  "version": "2.0.0",
  "description": "Comprehensive design tokens for the luxury Maldives travel marketplace, including 6 WCAG AA compliant palette directions, typography scale, elevations, and layout rules.",
