APP_ENV=
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
MEDIA_STORAGE_PATH=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Local only. Set to "true" to show browser-* test fixtures publicly. Ignored unless APP_ENV is exactly "local" (unset or empty does not count). Never enable in staging/production/preview or when a public tunnel is shared broadly.
ALLOW_TEST_FIXTURES=
# Local only. Set to "true" to enable the /login?uat=1 admin quick fill (uses SEED_ADMIN_*). Ignored unless APP_ENV is exactly "local". Never enable outside an explicit local workstation.
ENABLE_UAT_QUICK_FILL=
# Optional Google sign-in for existing customer accounts. Both values are required; omit to hide it.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# --- npm run dev:all (scripts/run-dev.ts) optional overrides ---
# Public exposure is OFF by default. Set ENABLE_DEV_TUNNEL=true to opt into the local tunnel proxy (127.0.0.1:3100).
# ENABLE_DEV_TUNNEL must be exactly "true". Provide DEV_TUNNEL_PUBLIC_URL (preferred) or a non-loopback AUTH_URL as the public https origin your tunnel forwards. Loopback AUTH_URL is rejected in tunnel mode. No production domain is assumed.
ENABLE_DEV_TUNNEL=
DEV_TUNNEL_PUBLIC_URL=
# Optional absolute or repo-relative path to a Team Board app. Leave empty to skip. Never commit machine-specific home paths.
ME_TEAM_BOARD_DIR=
# Optional port overrides for the launcher (loopback only).
DEV_APP_PORT=
DEV_DB_PORT=
DEV_TUNNEL_PROXY_PORT=
DEV_BOARD_PORT=
