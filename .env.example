APP_ENV=
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
MEDIA_STORAGE_PATH=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Local only. Set to "true" to show browser-* test fixtures publicly. Ignored unless APP_ENV is exactly "local" (unset or empty does not count).
ALLOW_TEST_FIXTURES=
# Local only. Set to "true" to enable the /login?uat=1 admin quick fill (uses SEED_ADMIN_*). Ignored unless APP_ENV is exactly "local".
ENABLE_UAT_QUICK_FILL=
# Optional Google sign-in for existing customer accounts. Both values are required; omit to hide it.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
