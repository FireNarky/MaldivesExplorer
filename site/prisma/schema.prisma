// Maldives Explorer database design
// Validated source for Documentation/Database_Design.md
// Prisma 6, PostgreSQL 16, extensions: pgcrypto, citext, pg_trgm

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext, pg_trgm]
}

// ---------------------------------------------------------------------------
// Enumerations
// Lifecycle enums are code. Business taxonomies live in VocabularyItem.
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum PublishStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED

  @@map("publish_status")
}

enum IslandType {
  RESORT
  LOCAL
  UNINHABITED

  @@map("island_type")
}

enum PropertyType {
  RESORT
  GUESTHOUSE
  LIVEABOARD

  @@map("property_type")
}

enum MediaKind {
  IMAGE
  VIDEO
  DRONE
  TOUR_360
  DOCUMENT

  @@map("media_kind")
}

enum MediaRole {
  HERO
  GALLERY
  OG
  PORTRAIT
  ATTACHMENT

  @@map("media_role")
}

enum MediaOwnerType {
  RESORT
  ROOM_TYPE
  DINING_VENUE
  ISLAND
  ATOLL
  EXPERIENCE
  OFFER
  ARTICLE
  EXPERT
  COLLECTION
  AWARD

  @@map("media_owner_type")
}

enum SavedEntityType {
  RESORT
  OFFER
  EXPERIENCE
  ARTICLE

  @@map("saved_entity_type")
}

enum CollectionEntityType {
  RESORT
  OFFER
  EXPERIENCE
  ARTICLE
  ISLAND
  ATOLL

  @@map("collection_entity_type")
}

enum ContentEntityType {
  RESORT
  OFFER
  EXPERIENCE
  ARTICLE
  ISLAND
  ATOLL

  @@map("content_entity_type")
}

enum FaqOwnerType {
  GLOBAL
  RESORT
  ISLAND
  ATOLL
  EXPERIENCE
  OFFER
  ARTICLE

  @@map("faq_owner_type")
}

enum AttachmentOwnerType {
  ENQUIRY
  QUOTE_VERSION
  NOTE
  MESSAGE

  @@map("attachment_owner_type")
}

enum EnquiryStatus {
  NEW
  CONTACT_ATTEMPTED
  CONTACTED
  QUALIFIED
  QUOTED
  NEGOTIATION
  WON
  LOST
  CLOSED

  @@map("enquiry_status")
}

enum TravelerType {
  ADULT
  CHILD
  INFANT

  @@map("traveler_type")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED

  @@map("task_status")
}

enum NoteVisibility {
  INTERNAL
  CUSTOMER

  @@map("note_visibility")
}

enum CommChannel {
  EMAIL
  PHONE
  PORTAL
  WHATSAPP

  @@map("comm_channel")
}

enum CommDirection {
  INBOUND
  OUTBOUND

  @@map("comm_direction")
}

enum QuoteVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  SUPERSEDED
  WITHDRAWN

  @@map("quote_version_status")
}

enum QuoteItemType {
  ACCOMMODATION
  TRANSFER
  EXPERIENCE
  TAX
  FEE
  DISCOUNT
  OTHER

  @@map("quote_item_type")
}

enum QuoteResponseType {
  CLARIFICATION
  ACCEPT
  DECLINE

  @@map("quote_response_type")
}

enum ConsentPurpose {
  ENQUIRY_CONTACT
  ACCOUNT
  NEWSLETTER
  ANALYTICS
  MARKETING

  @@map("consent_purpose")
}

enum ConsentStatus {
  GRANTED
  WITHDRAWN

  @@map("consent_status")
}

enum ConsentSubjectType {
  CUSTOMER
  USER
  SUBSCRIPTION
  ANONYMOUS

  @@map("consent_subject_type")
}

enum SubscriptionStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
  SUPPRESSED

  @@map("subscription_status")
}

enum ReviewSource {
  FIRST_PARTY
  EDITORIAL
