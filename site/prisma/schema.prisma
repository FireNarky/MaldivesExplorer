  notes          Note[]
  communications CommunicationLog[]
  quotes         Quote[]
  messages       Message[]

  @@index([customerId, createdAt])
  @@index([assignedUserId, status, createdAt])
  @@index([status, createdAt])
  @@index([tripTypeId])
  @@map("enquiries")
}

model EnquiryTraveler {
